params {
    trace_report_suffix                    = new Date().format("yyyy-MM-dd_HH-mm-ss")
    locus_breaker_method                   = "collector"
    locus_breaker_large_loci_size          = 1_500_000
    canonical_region_min_maf               = 0.01
    canonical_region_max_region_span_bp    = 3_000_000
    ld_registry                            = []
    ld_annotation_method                   = "hailing_ducks"
    hailing_ducks_container                = 'ghcr.io/project-defiant/hailing-ducks:v1.1.0'
    hailing_ducks_max_cached_blocks        = 8
    fine_mapping_methods                   = ['multisusie']
    multisusie_container                   = 'ghcr.io/project-defiant/multisusie:5f29d00f913b0f51c82ae9b180c8ec3c01df291e'
    multisusie_purity_min_r2               = 0.25
    susiex_container                       = 'ghcr.io/project-defiant/susiex/susiex:600051c01bdd14a2783d34066f8aaaa0e3dececf'
    sushie_container                       = 'ghcr.io/project-defiant/sushie/sushie:dd7e4ae3cb96cc7c6f5718e0bf4fbe77ab07bf93'
    empty_status_stub_emit                 = false
    ld_pair_stats_stub_emit                = false
    ld_pair_stats_stub_empty_locus_set_ids = []
    manifest_base_dir                      = "${projectDir}"
}

process {
    cpus   = 1
    memory = 2.GB

    shell  = [
        "bash",
        "-C",
        "-e",
        "-u",
        "-o",
        "pipefail",
    ]

    withLabel: collector {
        cpus   = 2
        memory = 4.GB
    }

    withLabel: multisusie {
        cpus   = 2
        memory = 16.GB
    }

    withLabel: susiex {
        cpus   = 4
        memory = 16.GB
    }

    withLabel: sushie {
        cpus   = 4
        memory = 16.GB
    }
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

docker {
    enabled = true
}


plugins {
    id 'nf-google'
    id 'nf-schema@2.8.0'
}

validation {
    ignoreParams = ['modules_testdata_base_path', 'pipelines_testdata_base_path']
}

profiles {
    testFullCollectorHailingDucks {
        includeConfig 'conf/test-full-collector-hailing-ducks.config'
    }
    googleCloud {
        includeConfig 'conf/google-cloud.config'
    }
    googleCloudTest {
        includeConfig 'conf/google-cloud-test.config'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/execution_timeline/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/execution_report/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/execution_trace/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.output_dir}/pipeline_info/pipeline_dag/pipeline_dag_${params.trace_report_suffix}.html"
}

// Base directory for the workflow-level output {} publish block.
// The output {} block uses relative paths; they are resolved against this.
outputDir = params.output_dir

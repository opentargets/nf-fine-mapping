executor.name = "local"

workDir = "${projectDir}/testdata/work"
params {
    manifest   = "${projectDir}/testdata/manifest.tsv"
    output_dir = "${projectDir}/testdata/output"
    route      = "multi_susie_route"
}

process {
    withLabel: gentropy {
        container        = 'ghcr.io/opentargets/gentropy:3.3.0-dev.64'
        containerOptions = '--entrypoint=""'
    }
    withLabel: collector {
        container = 'ghcr.io/opentargets/collector:1.0.0'
    }
    withLabel: locus_breaker {
        cpus       = 2
        memory     = 10.GB
        time       = 10.m
        maxRetries = 1
    }
}

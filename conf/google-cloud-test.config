executor.name = 'google-batch'

workDir = 'gs://gwas_catalog_multi_ancestry_fine_mapping/work_gcloud_test'
params {
    collector_container = 'ghcr.io/opentargets/nf-fine-mapping/collector:044f8476aeb015099d81f0f0ab6d7f047a9082f4'
    manifest = 'gs://gwas_catalog_multi_ancestry_fine_mapping/manifest.test3.tsv'
    manifest_base_dir = '.'
    output_dir = 'gs://gwas_catalog_multi_ancestry_fine_mapping/output_gcloud_test'
    route = 'multi_susie_route'
    locus_breaker_method = 'collector'
    ld_annotation_method = 'hailing_ducks'
    ld_registry = [
        [ancestry: 'nfe', ht_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.variant.b38.ht', bm_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm'],
        [ancestry: 'eas', ht_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.variant.b38.ht', bm_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.bm'],
        [ancestry: 'afr', ht_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.variant.b38.ht', bm_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.bm'],
    ]
    fine_mapping_methods = ['multisusie']
    hailing_ducks_container = 'ghcr.io/project-defiant/hailing-ducks:v1.1.0'
    hailing_ducks_max_cached_blocks = 8
    canonical_region_min_maf = 0.01
    canonical_region_max_region_span_bp = 3_000_000
}


google {
    enableRequesterPaysBuckets = true
    location                   = 'europe-west1'
    project                    = 'open-targets-eu-dev'
    batch {
        spot            = true
        maxSpotAttempts = 1
    }
}


process {
    withLabel: collector {
        cpus       = 2
        memory     = 8.GB
        container  = params.collector_container
    }
    withLabel: locus_breaker {
        cpus       = 2
        memory     = 8.GB
        time       = 10.m
        maxRetries = 1
    }
    withLabel: ld_annotation {
        // cpus is tiered to match what Google Batch actually provisions: a 2-vCPU
        // shape can't offer 24GB (C2D highmem-2 caps at 16GB), so Batch already
        // silently runs attempt 2 on a 4-vCPU c2d-highmem-4 (32GB) machine.
        // Declaring cpus=4 here just makes that explicit; the real machine and
        // cost are unchanged. Attempt 3's real shape is unverified -- left as-is.
        cpus          = { [2, 4, 2][Math.min(task.attempt - 1, 2)] }
        memory        = { [8.GB, 24.GB, 48.GB][Math.min(task.attempt - 1, 2)] }
        time          = 60.m
        maxRetries    = 2
        errorStrategy = { task.exitStatus in [137, 50002] ? 'retry' : 'terminate' }
    }
    withLabel: locus_collection {
        disk          = { [10.GB, 25.GB, 50.GB][Math.min(task.attempt - 1, 2)] }
        maxRetries    = 2
        errorStrategy = { task.exitStatus == 75 ? 'retry' : 'terminate' }
    }
    withLabel: multisusie {
        // Attempt-3's 48GB previously forced a c2d-highmem-8 (64GB) machine;
        // observed peak usage on that tier never exceeded ~20GB, so 32GB keeps
        // it on the cheaper c2d-standard-8 (32GB) shape instead.
        cpus          = { [2, 4, 8][Math.min(task.attempt - 1, 2)] }
        memory        = { [8.GB, 16.GB, 32.GB][Math.min(task.attempt - 1, 2)] }
        maxRetries    = 2
        errorStrategy = { task.exitStatus in [137, 50002] ? 'retry' : 'terminate' }
    }
    withLabel: susiex {
        cpus       = 2
        memory     = 8.GB
    }
    withLabel: sushie {
        cpus       = 2
        memory     = 8.GB
    }
}

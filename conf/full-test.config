executor.name = "local"

workDir = "${projectDir}/testdata/work_full"
params {
    manifest   = "${projectDir}/testdata/manifest.full.tsv"
    manifest_base_dir = "${projectDir}"
    output_dir = "${projectDir}/testdata/output_full"
    route      = "multi_susie_route"
    hailing_ducks_container = 'ghcr.io/project-defiant/hailing-ducks:v1.1.0'
    // The manifest uses EAS; the available Pan-UKBB CSA reference is the intentional proxy.
    ld_registry = [
        [ancestry: "nfe", ht_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.variant.b38.ht", vi_path: "${projectDir}/data/reference/panukbb/full_test/UKBB.EUR.aligned.parquet", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm"],
        [ancestry: "eas", ht_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.variant.b38.ht", vi_path: "${projectDir}/data/reference/panukbb/full_test/UKBB.CSA.aligned.parquet", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.bm"],
        [ancestry: "afr", ht_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.variant.b38.ht", vi_path: "${projectDir}/data/reference/panukbb/full_test/UKBB.AFR.aligned.parquet", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.bm"],
    ]
    gentropy_spark_uri = "local[2]"
    gentropy_spark_conf = "{spark.driver.memory:24g,spark.executor.memory:24g,spark.driver.maxResultSize:4g}"
    gentropy_ld_annotation_spark_conf = "{spark.driver.memory:24g,spark.executor.memory:24g,spark.driver.maxResultSize:8g,spark.ui.enabled:true,spark.ui.port:4040,spark.driver.bindAddress:0.0.0.0}"
}

process {
    withLabel: gentropy {
        cpus            = 4
        memory          = 24.GB
        container        = 'gentropy:3.4.0-dev.1-ld-pair-extraction-v2'
        containerOptions = '--entrypoint=""'
    }
    withLabel: collector {
        cpus       = 2
        memory     = 16.GB
        container  = 'ghcr.io/opentargets/collector:1.0.0'
    }
    withLabel: locus_breaker {
        cpus       = 2
        memory     = 28.GB
        time       = 30.m
        maxRetries = 1
    }
    withLabel: ld_annotation {
        cpus            = 8
        memory          = 32.GB
        time            = 90.m
        maxRetries = 1
        containerOptions = '--entrypoint="" --publish 4040:4040'
    }
    withLabel: multisusie {
        cpus       = 4
        memory     = 32.GB
    }
    withLabel: susiex {
        cpus       = 4
        memory     = 32.GB
    }
    withLabel: sushie {
        cpus       = 4
        memory     = 32.GB
    }
}

executor.name = 'google-batch'

workDir = 'gs://gwas_catalog_multi_ancestry_fine_mapping/work'
params {
    collector_container = 'ghcr.io/opentargets/nf-fine-mapping/collector:044f8476aeb015099d81f0f0ab6d7f047a9082f4'
    manifest   = 'gs://gwas_catalog_multi_ancestry_fine_mapping/manifest.tsv'
    output_dir = 'gs://gwas_catalog_multi_ancestry_fine_mapping/output'
    route      = "multi_susie_route"
    ld_registry = [
        [ancestry: 'nfe', ht_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.variant.b38.ht', bm_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm'],
        [ancestry: 'eas', ht_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.variant.b38.ht', bm_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.bm'],
        [ancestry: 'afr', ht_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.variant.b38.ht', bm_path: 's3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.bm'],
    ]
}


google {
    enableRequesterPaysBuckets = true
    location                   = 'europe-west1'
    project                    = 'open-targets-genetics-dev'
    batch {
        spot            = true
        maxSpotAttempts = 1
    }
}

process {
    withLabel: collector {
        cpus       = 2
        memory     = 10.GB
        container  = params.collector_container
    }
    // withName beats withLabel, so this overrides the container for the two
    // COLLECTOR_META_COLLAPSE aliases only. params.collector_container must stay
    // at its pinned digest: the container is part of the task hash, so changing
    // it would invalidate every cached collector-labelled task, including the
    // 6.01 h of HAILING_DUCKS_LD_ANNOTATION this benchmark exists to reuse.
    withName: '.*COLLECTOR_META_COLLAPSE.*' {
        container = params.meta_collapse_container ?: params.collector_container
    }
    withLabel: locus_breaker {
        cpus       = 2
        memory     = 10.GB
        time       = 10.m
        maxRetries = 1
    }
    withLabel: ld_annotation {
        cpus          = 8
        memory        = { [48.GB, 96.GB][Math.min(task.attempt - 1, 1)] }
        time          = 60.m
        maxRetries    = 1
        errorStrategy = { task.exitStatus in [137, 50002] ? 'retry' : 'terminate' }
    }
    withLabel: locus_collection {
        disk          = { [10.GB, 25.GB, 50.GB][Math.min(task.attempt - 1, 2)] }
        maxRetries    = 2
        errorStrategy = { task.exitStatus == 75 ? 'retry' : 'terminate' }
    }
    withLabel: multisusie {
        cpus          = { [8, 16][Math.min(task.attempt - 1, 1)] }
        memory        = { [48.GB, 96.GB][Math.min(task.attempt - 1, 1)] }
        maxRetries    = 1
        errorStrategy = { task.exitStatus in [137, 50002] ? 'retry' : 'terminate' }
    }
    withLabel: susiex {
        cpus       = 8
        memory     = 48.GB
    }
    withLabel: sushie {
        cpus       = 8
        memory     = 48.GB
    }
}

executor.name = 'google-batch'

workDir = 'gs://gwas_catalog_multi_ancestry_fine_mapping/work'
params {
    manifest   = 'gs://gwas_catalog_multi_ancestry_fine_mapping/manifest.tsv'
    output_dir = 'gs://gwas_catalog_multi_ancestry_fine_mapping/output'
}


google {
    enableRequesterPaysBuckets = true
    location                   = 'europe-west1'
    project                    = 'open-targets-genetics-dev'
    batch {
        spot            = true
        maxSpotAttempts = 1
    }
}

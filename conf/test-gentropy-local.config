executor.name = "local"

workDir = "${projectDir}/testdata/work_gentropy"
params {
    manifest                          = "${projectDir}/testdata/manifest.tsv"
    manifest_base_dir                 = "${projectDir}"
    output_dir                        = "${projectDir}/testdata/output_gentropy"
    route                             = "multi_susie_route"
    // The manifest uses EAS; the available Pan-UKBB CSA reference is the intentional proxy.
    ld_registry                       = [
        [ancestry: "nfe", vi_path: "${projectDir}/data/reference/panukbb/chr1/UKBB.EUR.aligned.parquet", bm_path: "s3a://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm"],
        [ancestry: "eas", vi_path: "${projectDir}/data/reference/panukbb/chr1/UKBB.CSA.aligned.parquet", bm_path: "s3a://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.bm"],
        [ancestry: "afr", vi_path: "${projectDir}/data/reference/panukbb/chr1/UKBB.AFR.aligned.parquet", bm_path: "s3a://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.bm"],
    ]

    locus_breaker_method              = "collector"
    gentropy_spark_uri                = "local[8]"
    gentropy_spark_conf               = "{spark.driver.memory:8g,spark.executor.memory:8g,spark.driver.maxResultSize:2g}"
    gentropy_ld_annotation_spark_conf = "{spark.driver.memory:12g,spark.executor.memory:12g,spark.driver.maxResultSize:4g}"
}

process {
    withLabel: gentropy {
        cpus            = 4
        memory          = 12.GB
        container        = 'gentropy:3.4.0-dev.1-ld-pair-extraction-v2'
        containerOptions = '--entrypoint=""'
    }
    withLabel: collector {
        cpus       = 2
        memory     = 10.GB
        container  = 'ghcr.io/opentargets/collector:1.0.0'
    }
    withLabel: locus_breaker {
        cpus       = 2
        memory     = 10.GB
        time       = 10.m
        maxRetries = 1
    }
    withLabel: ld_annotation {
        cpus       = 8
        memory     = 16.GB
        time       = 60.m
        maxRetries = 1
    }
    withLabel: multisusie {
        cpus       = 4
        memory     = 16.GB
    }
}

executor.name = "local"

workDir = "${projectDir}/testdata/work_gentropy"
params {
    manifest   = "${projectDir}/testdata/manifest.tsv"
    manifest_base_dir = "${projectDir}"
    output_dir = "${projectDir}/testdata/output_gentropy"
    route      = "multi_susie_route"
    ld_references = [
        [ancestry: "nfe", vi_path: "gs://gcp-public-data--gnomad/release/2.1.1/ld/gnomad.genomes.r2.1.1.NFE.common.ld.variant_indices.ht", bm_path: "gs://gcp-public-data--gnomad/release/2.1.1/ld/gnomad.genomes.r2.1.1.NFE.common.adj.ld.bm"],
        [ancestry: "eas", vi_path: "gs://gcp-public-data--gnomad/release/2.1.1/ld/gnomad.genomes.r2.1.1.EAS.common.ld.variant_indices.ht", bm_path: "gs://gcp-public-data--gnomad/release/2.1.1/ld/gnomad.genomes.r2.1.1.EAS.common.adj.ld.bm"],
        [ancestry: "afr", vi_path: "gs://gcp-public-data--gnomad/release/2.1.1/ld/gnomad.genomes.r2.1.1.AFR.common.ld.variant_indices.ht", bm_path: "gs://gcp-public-data--gnomad/release/2.1.1/ld/gnomad.genomes.r2.1.1.AFR.common.adj.ld.bm"],
    ]

    locus_breaker_method = "gentropy"
    gentropy_spark_uri   = "local[2]"
    gentropy_spark_conf  = "{spark.driver.memory:8g,spark.executor.memory:8g,spark.driver.maxResultSize:2g}"
}

process {
    withLabel: gentropy {
        container        = 'ghcr.io/opentargets/gentropy:3.3.0-dev.64'
        containerOptions = '--entrypoint=""'
    }
    withLabel: collector {
        container = 'ghcr.io/opentargets/collector:1.0.0'
    }
    withLabel: locus_breaker {
        cpus       = 2
        memory     = 10.GB
        time       = 10.m
        maxRetries = 1
    }
}

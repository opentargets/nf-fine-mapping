nextflow_pipeline {

    name "Test pipeline step wiring"
    script "../main.nf"
    tag "pipeline"
    tag "stub"
    options "-stub-run"

    test("runs collector locus breaker and locus collection on chr1 test data") {
        tag "collector"

        when {
            params {
                manifest = new File("testdata/manifest.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 60 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 12 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:GENTROPY_LOCUS_BREAKER_CLUMPING") } == 0 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECT_FINEMAPPING_LOCI") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:SPLIT_FINEMAPPING_LOCI") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECTOR_EMPTY_STATUS") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:GENTROPY_FINE_MAPPING_LOCUS_SET_LD_ANNOTATION") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:COLLECTOR_CHECK_LD_PAIR_STATS") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 8 }
            )
        }
    }

    test("runs gentropy locus breaker and locus collection on chr1 test data") {
        tag "gentropy"

        when {
            params {
                manifest = new File("testdata/manifest.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
                locus_breaker_method = "gentropy"
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 60 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 0 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:GENTROPY_LOCUS_BREAKER_CLUMPING") } == 12 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECT_FINEMAPPING_LOCI") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:SPLIT_FINEMAPPING_LOCI") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECTOR_EMPTY_STATUS") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:GENTROPY_FINE_MAPPING_LOCUS_SET_LD_ANNOTATION") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:COLLECTOR_CHECK_LD_PAIR_STATS") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 8 }
            )
        }
    }

    test("filters only locus sets with empty LD pairs") {
        tag "validation"

        when {
            params {
                manifest = new File("testdata/manifest.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
                ld_pair_stats_stub_emit = true
                ld_pair_stats_stub_empty_locus_set_ids = ["set-a"]
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:GENTROPY_FINE_MAPPING_LOCUS_SET_LD_ANNOTATION") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:COLLECTOR_CHECK_LD_PAIR_STATS") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 4 },
                { assert new File("${outputDir}/../results/locus_annotation/fine_mapping_locus_sets/set-b.parquet").exists() },
                { assert !new File("${outputDir}/../results/locus_annotation/fine_mapping_locus_sets/set-a.parquet").exists() }
            )
        }
    }

    test("excludes every row from runs reported invalid by manifest validation and preserves status artifacts") {
        tag "collector"
        tag "validation"

        when {
            params {
                manifest = new File("testdata/manifest.invalid_run.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
                ld_registry = [
                    [ancestry: "nfe", vi_path: "${projectDir}/data/reference/panukbb/chr1/UKBB.EUR.aligned.parquet", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm"],
                    [ancestry: "eas", vi_path: "${projectDir}/data/reference/panukbb/chr1/UKBB.CSA.aligned.parquet", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.bm"],
                    [ancestry: "afr", vi_path: "${projectDir}/data/reference/panukbb/chr1/UKBB.AFR.aligned.parquet", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.bm"],
                ]
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }
            def outputText = workflow.stdout.join('\n')
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 12 },
                { assert succeededTasks.count { task -> task.startsWith("MANIFEST_VALIDATION:MANIFEST_VALIDATION_REPORT") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:LOCUS_BREAKER_EMPTY_STATUS") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECT_FINEMAPPING_LOCI") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECTOR_EMPTY_STATUS") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:GENTROPY_FINE_MAPPING_LOCUS_SET_LD_ANNOTATION") } == 2 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 2 },
                { assert outputText.contains("RUN_INVALID.jsonl") },
                { assert outputText.contains("RUN_VALID") },
                { assert !outputText.contains("GCST90002351") }
            )
        }
    }
}

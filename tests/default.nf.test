nextflow_pipeline {

    name "Test pipeline step wiring"
    script "../main.nf"
    tag "pipeline"
    tag "stub"
    options "-stub-run"

    test("runs collector locus breaker, collection, and Hailing Ducks LD annotation on full test data") {
        tag "collector"

        when {
            params {
                manifest = new File("testdata/manifest.full.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
                ld_annotation_method = "hailing_ducks"
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 41 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 12 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECT_CANONICAL_REGIONS") } == 4 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:HAILING_DUCKS_LD_ANNOTATION") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:COLLECTOR_CHECK_LD_PAIR_STATS") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 8 }
            )
        }
    }

    test("filters only locus sets with empty LD pairs") {
        tag "validation"

        when {
            params {
                manifest = new File("testdata/manifest.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
                ld_annotation_method = "hailing_ducks"
                ld_pair_stats_stub_emit = true
                ld_pair_stats_stub_empty_locus_set_ids = ["set-a"]
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:HAILING_DUCKS_LD_ANNOTATION") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:COLLECTOR_CHECK_LD_PAIR_STATS") } == 8 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 4 },
                { assert new File("${outputDir}/locus_annotation/fine_mapping_locus_sets/set-b.parquet").exists() },
                { assert !new File("${outputDir}/locus_annotation/fine_mapping_locus_sets/set-a.parquet").exists() }
            )
        }
    }

    test("excludes every row from runs reported invalid by manifest validation and preserves status artifacts") {
        tag "collector"
        tag "validation"

        when {
            params {
                manifest = new File("testdata/manifest.invalid_run.tsv").canonicalPath
                manifest_base_dir = new File(".").canonicalPath
                output_dir = "$outputDir"
                ld_annotation_method = "hailing_ducks"
                ld_registry = [
                    [ancestry: "nfe", ht_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.variant.b38.ht", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.EUR.ldadj.bm"],
                    [ancestry: "eas", ht_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.variant.b38.ht", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.CSA.ldadj.bm"],
                    [ancestry: "afr", ht_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.variant.b38.ht", bm_path: "s3://pan-ukb-us-east-1/ld_release/UKBB.AFR.ldadj.bm"],
                ]
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }
            def outputText = workflow.stdout.join('\n')
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 10 },
                { assert succeededTasks.count { task -> task.startsWith("MANIFEST_VALIDATION:MANIFEST_VALIDATION_REPORT") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECT_CANONICAL_REGIONS") } == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:HAILING_DUCKS_LD_ANNOTATION") } == 2 },
                { assert succeededTasks.count { task -> task.startsWith("FINE_MAPPING:MULTISUSIE_FINE_MAPPING") } == 2 },
                { assert outputText.contains("RUN_INVALID.jsonl") },
                { assert outputText.contains("RUN_VALID") },
                { assert !outputText.contains("GCST90002351") }
            )
        }
    }
}

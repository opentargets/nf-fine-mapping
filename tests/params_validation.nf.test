nextflow_pipeline {

    name "Test nf-schema parameter validation"
    script "../main.nf"
    tag "pipeline"
    tag "stub"
    tag "validation"
    options "-stub-run"

    test("fails when a known parameter has the wrong type") {
        when {
            params {
                canonical_region_min_maf = "notanumber"
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("canonical_region_min_maf") },
                { assert output.contains("should be") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("fails when a known parameter violates its minimum") {
        when {
            params {
                hailing_ducks_max_cached_blocks = -5
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("hailing_ducks_max_cached_blocks") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("fails when MultiSuSiE purity threshold is zero") {
        when {
            params {
                multisusie_purity_min_r2 = 0.0
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("multisusie_purity_min_r2") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("fails when MultiSuSiE purity threshold is one") {
        when {
            params {
                multisusie_purity_min_r2 = 1.0
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("multisusie_purity_min_r2") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("fails when an unrecognized parameter is passed") {
        when {
            params {
                bogus_typo_param = 1
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("bogus_typo_param") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("fails when canonical_region_max_region_span_bp is below locus_breaker_large_loci_size for the collector backend") {
        when {
            params {
                locus_breaker_method = "collector"
                canonical_region_max_region_span_bp = 1_000_000
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("canonical_region_max_region_span_bp") },
                { assert output.contains("locus_breaker_large_loci_size") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("succeeds when canonical_region_max_region_span_bp is at least locus_breaker_large_loci_size for the collector backend") {
        when {
            params {
                locus_breaker_method = "collector"
                canonical_region_max_region_span_bp = 2_000_000
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 }
            )
        }
    }

    test("fails when canonical_region_max_region_span_bp exactly equals locus_breaker_large_loci_size for the collector backend") {
        when {
            params {
                locus_breaker_method = "collector"
                canonical_region_max_region_span_bp = 1_500_000
            }
        }

        then {
            def output = [workflow.stdout, workflow.stderr]
                .findAll { stream -> stream != null && stream.toString() }
                .collect { stream -> stream.toString() }
                .join("\n")

            assertAll(
                { assert workflow.failed },
                { assert workflow.exitStatus != 0 },
                { assert output.contains("canonical_region_max_region_span_bp") },
                { assert output.contains("locus_breaker_large_loci_size") },
                { assert workflow.trace.tasks().size() == 0 }
            )
        }
    }

    test("succeeds when canonical_region_max_region_span_bp is exactly locus_breaker_large_loci_size + 1 for the collector backend") {
        when {
            params {
                locus_breaker_method = "collector"
                canonical_region_max_region_span_bp = 1_500_001
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 }
            )
        }
    }

    test("succeeds and logs a parameter summary when parameters are valid") {
        then {
            // nf-test always runs Nextflow with `-quiet`, so `log.info` output
            // (which is what `paramsSummaryLog()` uses) never reaches
            // workflow.stdout/workflow.stderr. nf-test still writes the full,
            // unfiltered Nextflow log to meta/nextflow.log under the test's
            // launchDir regardless of `-quiet`, so read that instead to confirm
            // paramsSummaryLog() actually ran (as opposed to just asserting on
            // text that happens to appear in the workflow's own output summary).
            def nextflowLog = new File("${launchDir}/meta/nextflow.log").text

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert nextflowLog.contains("Core Nextflow options") }
            )
        }
    }
}

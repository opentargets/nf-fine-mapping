nextflow_workflow {

    name "Test LOCUS_BREAKER workflow"
    script "../../workflows/locus_breaker/main.nf"
    workflow "LOCUS_BREAKER"
    tag "workflow"
    tag "locus_breaker"
    tag "stub"
    topics "versions"
    options "-stub-run"

    test("runs collector implementation for each input sumstat") {
        tag "collector"

        when {
            params {
                output_dir = "$outputDir"
                locus_breaker_method = "collector"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        meta: [
                            runId: "RUN_A",
                            studyId: "GCST90002351",
                            route: "multi_susie_route",
                            ancestry: "nfe",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 519288,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90002351"),
                    ],
                    [
                        meta: [
                            runId: "RUN_A",
                            studyId: "GCST90018748",
                            route: "multi_susie_route",
                            ancestry: "eas",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 82810,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90018748"),
                    ],
                )
                """
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 2 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 2 },
                { assert workflow.out.ch_locus.size() == 2 },
                { assert workflow.out.ch_status.size() == 0 },
                { assert workflow.out.ch_locus.collect { row -> row.meta.studyId }.sort() == ["GCST90002351", "GCST90018748"] },
                { assert workflow.out.ch_locus.collect { row -> row.summary_statistics_path.toString().tokenize('/')[-1] }.sort() == ["GCST90002351", "GCST90018748"] },
                { assert workflow.out.ch_locus.every { row -> row.study_locus_path.toString().endsWith(".parquet") } },
                { assert topics.versions.size() == 2 },
                { assert topics.versions.count { row -> row[0].startsWith("LOCUS_BREAKER:COLLECTOR_LOCUS_BREAKER") } == 2 },
                { assert topics.versions.every { row -> row[1] == "collector" } },
                { assert topics.versions.every { row -> row[2] == "1.1.0" } }
            )
        }
    }

    test("emits collector empty-dataset status with the logical parquet path") {
        tag "collector"
        tag "status"

        when {
            params {
                output_dir = "$outputDir"
                locus_breaker_method = "collector"
                empty_status_stub_emit = true
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        meta: [
                            runId: "RUN_EMPTY",
                            studyId: "GCST90002351",
                            route: "multi_susie_route",
                            ancestry: "nfe",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 100,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90002351"),
                    ],
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.ch_locus.size() == 0 },
                { assert workflow.out.ch_status.size() == 1 },
                { assert workflow.out.ch_status[0].toString().endsWith("RUN_EMPTY--locus_breaker_clumped_study_locus__GCST90002351.parquet.jsonl") },
                { assert new File(workflow.out.ch_status[0].toString()).text.trim() == '{"runId":"RUN_EMPTY","path":"locus_breaker_clumped_study_locus/GCST90002351.parquet","validationStage":"LOCUS_BREAKER","reason":"EMPTY_DATASET"}' }
            )
        }
    }
}

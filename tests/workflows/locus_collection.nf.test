nextflow_workflow {

    name "Test LOCUS_COLLECTION workflow"
    script "../../workflows/locus_collection/main.nf"
    workflow "LOCUS_COLLECTION"
    tag "workflow"
    tag "locus_collection"
    tag "stub"
    topics "versions"
    options "-stub-run"

    test("groups study locus paths by runId and emits canonical-region locus-set outputs") {
        when {
            params {
                output_dir = "$outputDir"
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        meta: [
                            runId: "RUN_A",
                            studyId: "STUDY_A",
                            route: "multi_susie_route",
                            ancestry: "nfe",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 100,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90002351"),
                        study_locus_path: file("${projectDir}/testdata/sumstats/GCST90002351/GCST90002351.parquet"),
                    ],
                    [
                        meta: [
                            runId: "RUN_A",
                            studyId: "STUDY_B",
                            route: "multi_susie_route",
                            ancestry: "eas",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 200,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90018748"),
                        study_locus_path: file("${projectDir}/testdata/sumstats/GCST90018748/GCST90018748.parquet"),
                    ],
                    [
                        meta: [
                            runId: "RUN_A",
                            studyId: "STUDY_C",
                            route: "multi_susie_route",
                            ancestry: "afr",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 300,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90475531"),
                        study_locus_path: file("${projectDir}/testdata/sumstats/GCST90475531/chr1.parquet"),
                    ],
                )
                """
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 1 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_COLLECTION:COLLECT_CANONICAL_REGIONS") } == 1 },
                { assert workflow.out.ch_full_overlap_loci.size() == 2 },
                { assert workflow.out.ch_partial_overlap_loci.size() == 0 },
                { assert workflow.out.ch_non_overlap_loci.size() == 0 },
                { assert workflow.out.ch_collect_loci_stats.size() == 1 },
                { assert workflow.out.ch_locus_collection_status.size() == 0 },
                { assert workflow.out.ch_full_overlap_loci*.runId == ["RUN_A", "RUN_A"] },
                { assert workflow.out.ch_full_overlap_loci.collect { r -> r.metas.collect { meta -> meta.studyId } }.flatten() == ["STUDY_A", "STUDY_B", "STUDY_C", "STUDY_A", "STUDY_B", "STUDY_C"] },
                { assert workflow.out.ch_full_overlap_loci.collect { r -> r.collected_locus_path.toString().tokenize('/')[-1] }.sort() == ["set-a.parquet", "set-b.parquet"] },
                { assert workflow.out.ch_collect_loci_stats[0].runId == "RUN_A" },
                { assert workflow.out.ch_collect_loci_stats[0].stats_path.toString().endsWith("stats.json") },
                { assert workflow.out.ch_collect_loci_stats[0].stats_parquet_path.toString().endsWith("stats.parquet") },
                { assert topics.versions.size() == 1 },
                { assert topics.versions.every { row -> row[1] == "collector" } },
                { assert topics.versions.every { row -> row[2] == "1.1.0" } },
                { assert topics.versions.collect { row -> row[0] }.any { value -> value.startsWith("LOCUS_COLLECTION:COLLECT_CANONICAL_REGIONS") } },
            )
        }
    }

    test("emits empty-dataset status and suppresses locus-set outputs when no variants pass filters") {
        tag "status"

        when {
            params {
                output_dir = "$outputDir"
                empty_status_stub_emit = true
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        meta: [
                            runId: "RUN_EMPTY",
                            studyId: "STUDY_A",
                            route: "multi_susie_route",
                            ancestry: "nfe",
                            traitSet: ["EFO_0004833"],
                            sampleSize: 100,
                        ],
                        summary_statistics_path: file("${projectDir}/testdata/sumstats/GCST90002351"),
                        study_locus_path: file("${projectDir}/testdata/sumstats/GCST90002351/GCST90002351.parquet"),
                    ],
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 1 },
                { assert workflow.out.ch_full_overlap_loci.size() == 0 },
                { assert workflow.out.ch_locus_collection_status.size() == 1 },
                { assert workflow.out.ch_locus_collection_status[0].toString().endsWith(".jsonl") },
                { assert new File(workflow.out.ch_locus_collection_status[0].toString()).text.contains('"runId":"RUN_EMPTY"') },
            )
        }
    }
}

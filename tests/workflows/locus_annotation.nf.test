nextflow_workflow {

    name "Test LOCUS_ANNOTATION workflow backends"
    script "../../workflows/locus_annotation/main.nf"
    workflow "LOCUS_ANNOTATION"
    tag "workflow"
    tag "locus_annotation"
    tag "stub"
    topics "versions"
    options "-stub-run"

    test("runs Hailing Ducks LD annotation for full-overlap loci") {
        when {
            params {
                output_dir = "$outputDir"
                ld_annotation_method = "hailing_ducks"
                ld_pair_stats_stub_emit = false
                ld_registry = [
                    [ancestry: "nfe", ht_path: "s3://bucket/nfe.ht", bm_path: "s3://bucket/nfe.bm"],
                    [ancestry: "afr", ht_path: "s3://bucket/afr.ht", bm_path: "s3://bucket/afr.bm"],
                ]
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        runId: "RUN_A",
                        metas: [
                            [
                                runId: "RUN_A",
                                studyId: "STUDY_A",
                                route: "multi_susie_route",
                                ancestry: "nfe",
                                traitSet: ["EFO_0004833"],
                                sampleSize: 100,
                            ],
                            [
                                runId: "RUN_A",
                                studyId: "STUDY_B",
                                route: "multi_susie_route",
                                ancestry: "afr",
                                traitSet: ["EFO_0004833"],
                                sampleSize: 200,
                            ],
                        ],
                        collected_locus_path: file("${projectDir}/testdata/sumstats/GCST90475531/chr1.parquet"),
                    ],
                    [
                        runId: "RUN_A",
                        metas: [
                            [
                                runId: "RUN_A",
                                studyId: "STUDY_A",
                                route: "multi_susie_route",
                                ancestry: "nfe",
                                traitSet: ["EFO_0004833"],
                                sampleSize: 100,
                            ],
                            [
                                runId: "RUN_A",
                                studyId: "STUDY_B",
                                route: "multi_susie_route",
                                ancestry: "afr",
                                traitSet: ["EFO_0004833"],
                                sampleSize: 200,
                            ],
                        ],
                        collected_locus_path: file("${projectDir}/testdata/sumstats/GCST90018748/GCST90018748.parquet"),
                    ],
                )
                """
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:HAILING_DUCKS_LD_ANNOTATION") } == 2 },
                { assert workflow.out.ch_locus_annotation.size() == 2 },
                { assert workflow.out.ch_locus_annotation[0].runId == "RUN_A" },
                { assert workflow.out.ch_locus_annotation.collect { r -> r.fine_mapping_locus_set_path.toString().tokenize('/')[-1] }.sort() == ["GCST90018748.parquet", "chr1.parquet"] },
                { assert workflow.out.ch_locus_annotation.every { r -> r.multi_ancestry_pairwise_ld_path.toString().endsWith("multi_ancestry_pairwise_ld.parquet") } },
                { assert workflow.out.ch_locus_annotation.every { r -> r.multi_ancestry_pairwise_ld_path.toString().contains("RUN_A_") } },
                { assert workflow.out.ch_locus_annotation.every { r -> r.stats_path.toString().endsWith("stats.jsonl") } },
                { assert workflow.out.ch_fine_mapping_locus_sets.size() == 2 },
                { assert workflow.out.ch_multi_ancestry_pairwise_ld.size() == 2 },
                { assert workflow.out.ch_ld_pair_stats.size() == 2 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:COLLECTOR_CHECK_LD_PAIR_STATS") } == 2 },
                { assert topics.versions.size() == 2 },
                { assert topics.versions.any { row -> row[0].startsWith("LOCUS_ANNOTATION:HAILING_DUCKS_LD_ANNOTATION") && row[1] == "collector" && row[2] == "1.1.0" } },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:MULTISUSIE_FINE_MAPPING") } == 0 },
            )
        }
    }

    test("skips LD annotation when full-overlap channel is empty") {
        when {
            params {
                output_dir = "$outputDir"
                ld_annotation_method = "hailing_ducks"
            }
            workflow {
                """
                input[0] = channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert workflow.trace.succeeded().size() == 0 },
                { assert workflow.out.ch_locus_annotation.size() == 0 },
                { assert workflow.out.ch_fine_mapping_locus_sets.size() == 0 },
                { assert workflow.out.ch_multi_ancestry_pairwise_ld.size() == 0 },
                { assert workflow.out.ch_ld_pair_stats.size() == 0 }
            )
        }
    }

    test("filters locus sets with invalid LD pairs") {
        when {
            params {
                output_dir = "$outputDir"
                ld_annotation_method = "hailing_ducks"
                ld_pair_stats_stub_emit = true
                ld_registry = [
                    [ancestry: "nfe", ht_path: "s3://bucket/nfe.ht", bm_path: "s3://bucket/nfe.bm"],
                    [ancestry: "afr", ht_path: "s3://bucket/afr.ht", bm_path: "s3://bucket/afr.bm"],
                ]
            }
            workflow {
                """
                input[0] = channel.of(
                    [
                        runId: "RUN_HAILING",
                        metas: [
                            [runId: "RUN_HAILING", studyId: "STUDY_A", route: "multi_susie_route", ancestry: "nfe", traitSet: ["EFO_1"], sampleSize: 100],
                            [runId: "RUN_HAILING", studyId: "STUDY_B", route: "multi_susie_route", ancestry: "afr", traitSet: ["EFO_1"], sampleSize: 200],
                        ],
                        collected_locus_path: file("${projectDir}/testdata/sumstats/GCST90475531/chr1.parquet"),
                    ],
                )
                """
            }
        }

        then {
            def succeededTasks = workflow.trace.succeeded().collect { task -> task.name.toString() }

            assertAll(
                { assert workflow.success },
                { assert workflow.trace.failed().size() == 0 },
                { assert succeededTasks.count { task -> task.startsWith("LOCUS_ANNOTATION:HAILING_DUCKS_LD_ANNOTATION") } == 1 },
                { assert workflow.out.ch_locus_annotation.size() == 0 },
                { assert workflow.out.ch_fine_mapping_locus_sets.size() == 0 },
                { assert workflow.out.ch_multi_ancestry_pairwise_ld.size() == 0 },
                { assert workflow.out.ch_ld_pair_stats.size() == 0 },
                { assert workflow.out.ch_ld_pair_stats_status.size() == 1 },
                { assert workflow.out.ch_ld_pair_stats_status.every { path -> new File(path.toString()).text.contains('"fineMappingLocusSetId"') } },
            )
        }
    }
}

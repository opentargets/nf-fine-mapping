%%metro dir: status_collection | Locus Collection Status
%%metro dir: status_annotation | Locus Annotation Status

graph LR
    subgraph input [Input]
        study_in[OpenTargets Study]
    end

    subgraph fm_planner [Fine-mapping Planner]
        planner[Fine-mapping Planner]
    end

    subgraph fm_manifest [Fine-mapping Manifest Generator]
        manifest_gen[Fine-mapping Manifest Generator]
        manifest_in[ ]
        manifest_gen -->|main| manifest_in
    end

    subgraph validation_stage [Manifest Validation]
        validate[Manifest Validation]
        report_validation[ ]
        validate -->|line_report_validation| report_validation
    end

    subgraph locus_breaker [Locus Breaker]
        lb[LocusBreaker]
        loci_out[ ]
        status_lb[ ]
        lb -->|line_loci| loci_out
        lb -->|line_status_lb| status_lb
    end

    subgraph locus_collection [Locus Collection]
        collect[Canonical Region Collection]
        collected_out[ ]
        collect_stats_out[ ]
        status_collection[ ]
        collect -->|line_collected| collected_out
        collect -->|line_collect_stats| collect_stats_out
        collect -->|line_status_collection| status_collection
    end

    subgraph locus_annotation [Locus Annotation]
        ld_hailing[Hailing Ducks LD Annotation]
        annotated_out[ ]
        ld_pair_stats_out[ ]
        status_annotation[ ]
        ld_hailing -->|line_annotated| annotated_out
        ld_hailing -->|line_ld_pair_stats| ld_pair_stats_out
        ld_hailing -->|line_status_annotation| status_annotation
    end

    subgraph fine_mapping [Fine Mapping]
        multisusie[MultiSuSiE]
        credible_sets_out[ ]
        anndata_out[ ]
        fm_stats_out[ ]
        multisusie -->|line_credible_sets| credible_sets_out
        multisusie -->|line_anndata| anndata_out
        multisusie -->|line_fm_stats| fm_stats_out
    end

    study_in -->|main| planner
    planner -->|main| manifest_gen
    manifest_in -->|main| validate
    validate -->|main| lb
    lb -->|main| collect
    collect -->|main| ld_hailing
    ld_hailing -->|main| multisusie

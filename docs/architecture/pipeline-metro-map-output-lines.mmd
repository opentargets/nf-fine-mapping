%%metro file: manifest_in | TSV | Manifest
%%metro dir: loci_out | Loci
%%metro dir: collected_out | Collected Loci
%%metro dir: collect_stats_out | Collection Stats
%%metro dir: annotated_out | Annotated Locus Sets
%%metro dir: ld_pair_stats_out | LD-pair Stats
%%metro dir: credible_sets_out | Credible Sets
%%metro dir: anndata_out | AnnData
%%metro dir: fm_stats_out | Fine-mapping Stats

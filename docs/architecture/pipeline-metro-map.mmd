%%metro title: nf-fine-mapping pipeline
%%metro caption: opentargets/nf-fine-mapping — rendered with nf-metro from main.nf
%%metro style: dark
%%metro line: main | Pipeline | #22d3ee
%%metro line: validation | Validation & QC | #ef4444 | dashed
%%metro line: lb_collector | LocusBreaker: Collector | #14b8a6 | dashed
%%metro line: lb_gentropy | LocusBreaker: Gentropy | #8b5cf6 | dashed
%%metro line: ld_gentropy | LD Annotation: Gentropy | #6366f1 | dashed
%%metro line: ld_hailing | LD Annotation: Hailing Ducks | #f59e0b | dashed
%%metro line: fm_multisusie | Fine-mapping: MultiSuSiE | #ec4899
%%metro line: fm_susiex | Fine-mapping: SuSiEx | #34d399
%%metro line: fm_sushie | Fine-mapping: SuShiE | #facc15

%%metro file: manifest_in | TSV | Manifest
%%metro dir: loci_dir | Loci
%%metro dir: annotated_dir | Annotated
%%metro dir: results_dir | Results
%%metro dir: reports_dir | Reports

graph LR
    subgraph input [Input]
        manifest_in[ ]
    end

    subgraph validation_stage [Manifest Validation]
        validate[Manifest Validation]
    end

    subgraph locus_breaker [Locus Breaker]
        _lb_branch[ ]
        lb_collector[Collector LocusBreaker]
        lb_gentropy[Gentropy LocusBreaker]
        _lb_branch -->|lb_collector| lb_collector
        _lb_branch -->|lb_gentropy| lb_gentropy
    end

    subgraph locus_collection [Locus Collection]
        collect[Canonical Region Collection]
    end

    subgraph locus_annotation [Locus Annotation]
        _ld_branch[ ]
        ld_gentropy[Gentropy LD Annotation]
        ld_hailing[Hailing Ducks LD Annotation]
        _ld_converge[ ]
        _ld_branch -->|ld_gentropy| ld_gentropy
        _ld_branch -->|ld_hailing| ld_hailing
        ld_gentropy -->|main| _ld_converge
        ld_hailing -->|main| _ld_converge
    end

    subgraph fine_mapping [Fine Mapping]
        _fm_branch[ ]
        multisusie[MultiSuSiE]
        susiex[SuSiEx]
        sushie[SuShiE]
        _fm_branch -->|fm_multisusie| multisusie
        _fm_branch -->|fm_susiex| susiex
        _fm_branch -->|fm_sushie| sushie
    end

    subgraph publish [Published Outputs]
        loci_dir[ ]
        annotated_dir[ ]
        results_dir[ ]
        reports_dir[ ]
    end

    manifest_in -->|main| validate
    validate -->|main,lb_collector,lb_gentropy| _lb_branch
    lb_collector -->|main| collect
    lb_gentropy -->|main| collect
    collect -->|main,ld_gentropy,ld_hailing| _ld_branch
    _ld_converge -->|main,fm_multisusie,fm_susiex,fm_sushie| _fm_branch
    multisusie -->|main,fm_multisusie| results_dir
    susiex -->|main,fm_susiex| results_dir
    sushie -->|main,fm_sushie| results_dir

    lb_collector -->|main| loci_dir
    lb_gentropy -->|main| loci_dir
    collect -->|main| loci_dir
    ld_gentropy -->|main| annotated_dir
    ld_hailing -->|main| annotated_dir

    validate -->|validation| reports_dir
    lb_collector -->|validation| reports_dir
    lb_gentropy -->|validation| reports_dir
    collect -->|validation| reports_dir
    ld_gentropy -->|validation| reports_dir
    ld_hailing -->|validation| reports_dir
